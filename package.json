{
  "name": "arenapulse",
  "version": "1.0.0",
  "description": "Real-Time eSports match dashboard and event processing service",
  "keywords": [
    "esports",
    "dashboard",
    "nodejs",
    "websocket",
    "realtime"
  ],
  "license": "AGPL-3.0-only",
  "author": "DrX-svg",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "pages:dev": "wrangler pages dev public"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "wrangler": "^4.118.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260730.1": true
  }
}
